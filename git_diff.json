e.put(\"activeResidentCount\", activeResidents);"}, {"type": "added", "content": "    response.put(\"turnoutPercentage\", turnout);"}, {"type": "added", "content": "    response.put(\"minimumQuorumPercentage\", poll.minimumQuorumPercentage);"}, {"type": "added", "content": "    response.put(\"quorumStatus\", quorumMet ? \"MET\" : \"NOT_MET\");"}, {"type": "added", "content": "    response.put(\"options\", optionBreakdown);"}, {"type": "added", "content": "    if (!quorumMet) {"}, {"type": "added", "content": "      response.put(\"outcome\", \"INVALID\");"}, {"type": "added", "content": "      response.put(\"winningOptions\", List.of());"}, {"type": "added", "content": "    } else {"}, {"type": "added", "content": "      long highest = poll.options.stream().mapToLong(o -> o.voteCount).max().orElse(0);"}, {"type": "added", "content": "      List<String> winners = poll.options.stream().filter(o -> o.voteCount == highest).map(o -> o.optionText).collect(Collectors.toList());"}, {"type": "added", "content": "      response.put(\"outcome\", winners.size() > 1 ? \"TIE\" : \"WINNER\");"}, {"type": "added", "content": "      response.put(\"winningOptions\", winners);"}, {"type": "added", "content": "    }"}, {"type": "added", "content": "    return response;"}, {"type": "added", "content": "  }"}, {"type": "added", "content": ""}, {"type": "added", "content": "  @Transactional(readOnly = true)"}, {"type": "added", "content": "  public Map<String, Object> votingHistory(Long residentId, int offset, int limit) {"}, {"type": "added", "content": "    resident(residentId);"}, {"type": "added", "content": "    return page("}, {"type": "added", "content": "        votes.findByResidentIdOrderByTimestampDesc(residentId).stream()"}, {"type": "added", "content": "            .map(v -> Map.<String, Object>of(\"pollId\", v.poll.id, \"timestamp\", v.timestamp.toString())),"}, {"type": "added", "content": "        offset,"}, {"type": "added", "content": "        limit);"}, {"type": "added", "content": "  }"}, {"type": "added", "content": ""}, {"type": "added", "content": "  private void applyPollFields(Poll poll, Map<String, Object> body) {"}, {"type": "added", "content": "    if (body.containsKey(\"question\") || poll.question == null) poll.question = required(body, \"question\");"}, {"type": "added", "content": "    if (body.containsKey(\"votingStartTime\") || poll.votingStartTime == null) poll.votingStartTime = requiredTime(body, \"votingStartTime\");"}, {"type": "added", "content": "    if (body.containsKey(\"votingEndTime\") || poll.votingEndTime == null) poll.votingEndTime = requiredTime(body, \"votingEndTime\");"}, {"type": "added", "content": "    if (body.containsKey(\"minimumQuorumPercentage\") || poll.minimumQuorumPercentage == 0) {"}, {"type": "added", "content": "      poll.minimumQuorumPercentage = doubleValue(body, \"minimumQuorumPercentage\");"}, {"type": "added", "content": "    }"}, {"type": "added", "content": "    if (!poll.votingEndTime.isAfter(poll.votingStartTime)) throw badRequest(\"votingEndTime must be after votingStartTime\");"}, {"type": "added", "content": "    if (poll.minimumQuorumPercentage < 0 || poll.minimumQuorumPercentage > 100) throw badRequest(\"minimumQuorumPercentage must be between 0 and 100\");"}, {"type": "added", "content": "  }"}, {"type": "added", "content": ""}, {"type": "added", "content": "  @SuppressWarnings(\"unchecked\")"}, {"type": "added", "content": "  private List<String> optionTexts(Map<String, Object> body) {"}, {"type": "added", "content": "    Object raw = body.get(\"options\");"}, {"type": "added", "content": "    if (!(raw instanceof List<?>)) throw badRequest(\"options must contain at least two entries\");"}, {"type": "added", "content": "    List<String> texts = ((List<Object>) raw).stream().map(String::valueOf).filter(s -> !s.isBlank()).collect(Collectors.toList());"}, {"type": "added", "content": "    if (texts.size() < 2) throw badRequest(\"poll must contain at least two options\");"}, {"type": "added", "content": "    return texts;"}, {"type": "added", "content": "  }"}, {"type": "added", "content": ""}, {"type": "added", "content": "  private void attachOptions(Poll poll, List<String> texts) {"}, {"type": "added", "content": "    for (String text : texts) {"}, {"type": "added", "content": "      PollOption option = new PollOption();"}, {"type": "added", "content": "      option.poll = poll;"}, {"type": "added", "content": "      option.optionText = text;"}, {"type": "added", "content": "      poll.options.add(option);"}, {"type": "added", "content": "    }"}, {"type": "added", "content": "  }"}, {"type": "added", "content": ""}, {"type": "added", "content": "  private String status(Poll poll, LocalDateTime now) {"}, {"type": "added", "content": "    if (poll.cancelled) return \"CANCELLED\";"}, {"type": "added", "content": "    if (!now.isAfter(poll.votingStartTime)) return \"UPCOMING\";"}, {"type": "added", "content": "    return now.isBefore(poll.votingEndTime) ? \"ACTIVE\" : \"CLOSED\";"}, {"type": "added", "content": "  }"}, {"type": "added", "content": ""}, {"type": "added", "content": "  private String quorumStatus(Poll poll, LocalDateTime now) {"}, {"type": "added", "content": "    if (!\"CLOSED\".equals(status(poll, now))) return \"PENDING\";"}, {"type": "added", "content": "    long count = votes.findByPollId(poll.id).size();"}, {"type": "added", "content": "    long eligible = residents.findAll().stream().filter(r -> r.active && r.flat != null && r.flat.active).count();"}, {"type": "added", "content": "    return eligible > 0 && count * 100.0 / eligible >= poll.minimumQuorumPercentage ? \"MET\" : \"NOT_MET\";"}, {"type": "added", "content": "  }"}, {"type": "added", "content": ""}, {"type": "added", "content": "  private Map<String, Object> notice(Notice notice) {"}, {"type": "added", "content": "    Map<String, Object> response = new LinkedHashMap<>();"}, {"type": "added", "content": "    response.put(\"id\", notice.id);"}, {"type": "added", "content": "    response.put(\"title\", notice.title);"}, {"type": "added", "content": "    response.put(\"description\", notice.description);"}, {"type": "added", "content": "    response.put(\"category\", notice.category.name());"}, {"type": "added", "content": "    response.put(\"postedDate\", notice.postedDate.toString());"}, {"type": "added", "content": "    response.put(\"expiryDate\", notice.expiryDate == null ? null : notice.expiryDate.toString());"}, {"type": "added", "content": "    response.put(\"expired\", notice.expired || (notice.expiryDate != null && !notice.expiryDate.isAfter(LocalDateTime.now())));"}, {"type": "added", "content": "    return response;"}, {"type": "added", "content": "  }"}, {"type": "added", "content": ""}, {"type": "added", "content": "  private Map<String, Object> poll(Poll poll) {"}, {"type": "added", "content": "    Map<String, Object> response = new LinkedHashMap<>();"}, {"type": "added", "content": "    response.put(\"id\", poll.id);"}, {"type": "added", "content": "    response.put(\"question\", poll.question);"}, {"type": "added", "content": "    response.put(\"votingStartTime\", poll.votingStartTime.toString());"}, {"type": "added", "content": "    response.put(\"votingEndTime\", poll.votingEndTime.toString());"}, {"type": "added", "content": "    response.put(\"minimumQuorumPercentage\", poll.minimumQuorumPercentage);"}, {"type": "added", "content": "    response.put(\"noticeId\", poll.notice == null ? null : poll.notice.id);"}, {"type": "added", "content": "    response.put(\"status\", status(poll, LocalDateTime.now()));"}, {"type": "added", "content": "    response.put(\"cancelled\", poll.cancelled);"}, {"type": "added", "content": "    response.put(\"cancellationReason\", poll.cancellationReason == null ? null : poll.cancellationReason);"}, {"type": "added", "content": "    response.put(\"options\", poll.options.stream().map(o -> Map.of(\"id\", o.id, \"optionText\", o.optionText)).collect(Collectors.toList()));"}, {"type": "added", "content": "    return response;"}, {"type": "added", "content": "  }"}, {"type": "added", "content": ""}, {"type": "added", "content": "  private Map<String, Object> page(java.util.stream.Stream<Map<String, Object>> stream, int offset, int limit) {"}, {"type": "added", "content": "    if (offset < 0 || limit < 1 || limit > 100) throw badRequest(\"offset must be non-negative and limit must be between 1 and 100\");"}, {"type": "added", "content": "    List<Map<String, Object>> all = stream.collect(Collectors.toList());"}, {"type": "added", "content": "    int from = Math.min(offset, all.size());"}, {"type": "added", "content": "    int to = Math.min(from + limit, all.size());"}, {"type": "added", "content": "    return Map.of(\"total\", all.size(), \"offset\", offset, \"limit\", limit, \"items\", all.subList(from, to));"}, {"type": "added", "content": "  }"}, {"type": "added", "content": ""}, {"type": "added", "content": "  private Notice noticeEntity(Long id) { return notices.findById(id).orElseThrow(() -> notFound(\"notice not found\")); }"}, {"type": "added", "content": "  private Poll pollEntity(Long id) { return polls.findById(id).orElseThrow(() -> notFound(\"poll not found\")); }"}, {"type": "added", "content": "  private PollOption option(Long id) { return options.findById(id).orElseThrow(() -> notFound(\"poll option not found\")); }"}, {"type": "added", "content": "  private Resident resident(Long id) { return residents.findById(id).orElseThrow(() -> notFound(\"resident not found\")); }"}, {"type": "added", "content": "  private String required(Map<String, Object> body, String key) { Object value = body.get(key); if (value == null || String.valueOf(value).isBlank()) throw badRequest(key + \" is required\"); return String.valueOf(value); }"}, {"type": "added", "content": "  private Long longValue(Map<String, Object> body, String key) { try { return Long.valueOf(required(body, key)); } catch (NumberFormatException e) { throw badRequest(key + \" must be a number\"); } }"}, {"type": "added", "content": "  private double doubleValue(Map<String, Object> body, String key) { try { return Double.parseDouble(required(body, key)); } catch (NumberFormatException e) { throw badRequest(key + \" must be numeric\"); } }"}, {"type": "added", "content": "  private LocalDateTime requiredTime(Map<String, Object> body, String key) { try { return LocalDateTime.parse(required(body, key)); } catch (RuntimeException e) { throw badRequest(key + \" must be ISO-8601 local date-time\"); } }"}, {"type": "added", "content": "  private LocalDateTime optionalTime(Map<String, Object> body, String key) { Object value = body.get(key); return value == null || String.valueOf(value).isBlank() ? null : requiredTime(body, key); }"}, {"type": "added", "content": "  private NoticeCategory category(String value) { try { return NoticeCategory.valueOf(value.toUpperCase()); } catch (IllegalArgumentException e) { throw badRequest(\"category must be GENERAL, URGENT, or EVENT\"); } }"}, {"type": "added", "content": "  private ResponseStatusException badRequest(String message) { return new ResponseStatusException(HttpStatus.BAD_REQUEST, message); }"}, {"type": "added", "content": "  private ResponseStatusException notFound(String message) { return new ResponseStatusException(HttpStatus.NOT_FOUND, message); }"}, {"type": "added", "content": "}"}]}]}, {"path": "src/main/resources/application.properties", "additions": 5, "deletions": 5, "hunks": [{"header": "@@ -1,7 +1,7 @@", "lines": [{"type": "removed", "content": "server.port=29976"}, {"type": "removed", "content": "spring.datasource.url=${DB_URL}"}, {"type": "removed", "content": "spring.datasource.username=${DB_USER}"}, {"type": "removed", "content": "spring.datasource.password=${DB_PASSWORD}"}, {"type": "added", "content": "server.port=21126"}, {"type": "added", "content": "spring.datasource.url=jdbc:postgresql://localhost:5432/gen_1e9802722e6b"}, {"type": "added", "content": "spring.datasource.us